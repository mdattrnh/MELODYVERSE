<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_screen_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quản trị"
                    android:textColor="@color/colorTextPrimary"
                    android:textStyle="bold"
                    android:textSize="28sp"
                    android:letterSpacing="-0.02" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kiểm duyệt nội dung và người dùng"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Cục Đăng Xuất Admin Nổi Bật -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_admin_top_logout"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Đăng xuất"
                android:textAllCaps="false"
                android:minWidth="0dp"
                android:textColor="@color/colorDanger"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_danger_soft"
                android:drawableStart="@drawable/ic_logout"
                android:drawableTint="@color/colorDanger"
                android:drawablePadding="6dp"
                android:paddingStart="12dp"
                android:paddingEnd="14dp" />
        </LinearLayout>

        <!-- Stats Grid (2x2) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <!-- Card 1: Posts -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card_gradient"
                android:padding="16dp"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bài đăng"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_admin_stat_posts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4"
                    android:textColor="@color/colorTextPrimary"
                    android:textStyle="bold"
                    android:textSize="24sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Card 2: Users -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card_gradient"
                android:padding="16dp"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Người dùng"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_admin_stat_users"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3"
                    android:textColor="@color/colorTextPrimary"
                    android:textStyle="bold"
                    android:textSize="24sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <!-- Card 3: Bài viết vi phạm cần xử lý -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card_gradient"
                android:padding="16dp"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vi phạm cần xử lý"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_admin_stat_reports"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/colorDanger"
                    android:textStyle="bold"
                    android:textSize="24sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Card 4: Server Status -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card_gradient"
                android:padding="16dp"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hệ thống"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_admin_stat_system"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="●  Đang kiểm tra"
                    android:textColor="@color/colorTextSecondary"
                    android:textStyle="bold"
                    android:textSize="17sp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tab Switcher (3 khu vực: Bài hát, Người dùng, Bài viết vi phạm) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_segmented"
            android:padding="4dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:id="@+id/tab_admin_posts"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Bài hát"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="14sp"
                android:gravity="center"
                android:background="@drawable/bg_chip_selected" />

            <TextView
                android:id="@+id/tab_admin_users"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Người dùng"
                android:textColor="@color/colorTextSecondary"
                android:textSize="14sp"
                android:gravity="center"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/tab_admin_reports"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Vi phạm"
                android:textColor="@color/colorTextSecondary"
                android:textSize="14sp"
                android:gravity="center"
                android:background="?attr/selectableItemBackground" />
        </LinearLayout>

        <!-- Empty indicator -->
        <TextView
            android:id="@+id/tv_admin_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Không có dữ liệu hiển thị"
            android:textColor="@color/colorTextMuted"
            android:textSize="13sp"
            android:textAlignment="center"
            android:padding="20dp"
            android:visibility="gone" />

        <!-- Recycler View for Posts -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_admin_posts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <!-- Users Management Container with Search Bar -->
        <LinearLayout
            android:id="@+id/layout_admin_users_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/et_admin_search_users"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_search_pill"
                android:hint="Tìm theo tên hoặc username"
                android:textColorHint="@color/colorInputHint"
                android:textColor="@color/colorTextPrimary"
                android:textSize="13sp"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="10dp"
                android:drawableTint="@color/colorPrimary"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:imeOptions="actionSearch"
                android:layout_marginBottom="12dp" />

            <!-- Recycler View for Users -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_admin_users"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>

        <!-- Bài viết vi phạm: các bài bị thành viên báo cáo, Quản trị viên ẩn / xóa / bỏ qua -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_admin_reports"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
