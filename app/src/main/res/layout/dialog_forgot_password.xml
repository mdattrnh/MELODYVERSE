<?xml version="1.0" encoding="utf-8"?>
<!-- Hộp thoại Quên mật khẩu: nhập username hoặc email để nhận link đặt lại mật khẩu (Firebase Authentication) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_gradient"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nhập tên đăng nhập hoặc email đã đăng ký. Google sẽ gửi link đặt lại mật khẩu tới email của tài khoản."
        android:textColor="@color/colorTextPrimary"
        android:textSize="14sp"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/et_forgot_identifier"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_input_field"
        android:hint="Tên đăng nhập hoặc email"
        android:inputType="textEmailAddress"
        android:textColorHint="@color/colorInputHint"
        android:textColor="@color/colorTextPrimary"
        android:textSize="15sp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:singleLine="true" />

</LinearLayout>
