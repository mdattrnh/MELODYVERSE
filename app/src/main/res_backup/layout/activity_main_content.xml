<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient">

    <!-- Top App Bar -->
    <LinearLayout
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_app_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MELODYVERSE"
            android:textColor="@color/colorTextPrimary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

        <!-- Nút Kính lúp Tìm kiếm -->
        <FrameLayout
            android:id="@+id/btn_header_search"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_search"
                app:tint="@color/colorTextPrimary" />
        </FrameLayout>

        <!-- Nút Chuông thông báo -->
        <FrameLayout
            android:id="@+id/layout_bell"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/iv_header_bell"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_notifications"
                app:tint="@color/colorTextPrimary" />

            <!-- Active notification dot -->
            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_circle_placeholder" />
        </FrameLayout>
    </LinearLayout>

    <!-- Thanh tìm kiếm mở rộng (Ẩn mặc định, nhấn kính lúp để mở) -->
    <LinearLayout
        android:id="@+id/layout_search_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="2dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/header_bar">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="44dp">

            <EditText
                android:id="@+id/et_search"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_login_input"
                android:hint="Tìm bài hát, nghệ sĩ, thể loại..."
                android:textColorHint="@color/colorInputHint"
                android:textColor="@color/colorTextPrimary"
                android:textSize="13.5sp"
                android:paddingStart="16dp"
                android:paddingEnd="40dp"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="10dp"
                android:drawableTint="@color/colorPrimary"
                android:imeOptions="actionSearch"
                android:singleLine="true" />

            <ImageView
                android:id="@+id/iv_clear_search"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_close"
                android:padding="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/colorTextSecondary"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Toàn bộ nội dung cuộn mượt mà (Tự động thu gọn khi lướt xuống) -->
    <!-- Vuốt xuống để làm mới bảng tin (đồng bộ Firebase -> SQLite) -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_main"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/layout_search_bar"
        app:layout_constraintBottom_toBottomOf="parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nested_scroll_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Genre & Mood Filter Pills (Horizontal Scroll) -->
            <HorizontalScrollView
                android:id="@+id/scroll_genres"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:scrollbars="none"
                android:clipToPadding="false"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chip_genre_all"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:text="Tất cả"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="12.5sp"
                        android:gravity="center"
                        android:background="@drawable/bg_chip_selected"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/chip_genre_trending"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:text="BXH Thịnh hành"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="12.5sp"
                        android:gravity="center"
                        android:background="@drawable/bg_chip_unselected"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/chip_genre_vpop"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:text="V-Pop Say Hi"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="12.5sp"
                        android:gravity="center"
                        android:background="@drawable/bg_chip_unselected"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/chip_genre_rap"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:text="Rap / Hip-Hop"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="12.5sp"
                        android:gravity="center"
                        android:background="@drawable/bg_chip_unselected"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/chip_genre_chill"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:text="Indie &amp; Chill"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="12.5sp"
                        android:gravity="center"
                        android:background="@drawable/bg_chip_unselected"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/chip_genre_rnb"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:text="R&amp;B / Retro"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="12.5sp"
                        android:gravity="center"
                        android:background="@drawable/bg_chip_unselected"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Suggestions Header -->
            <LinearLayout
                android:id="@+id/layout_suggest_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp">

                <TextView
                    android:id="@+id/tv_suggest"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Gợi ý nghệ sĩ &amp; bạn bè"
                    android:textColor="@color/colorTextPrimary"
                    android:textStyle="bold"
                    android:textSize="14.5sp" />

                <TextView
                    android:id="@+id/tv_see_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Xem tất cả"
                    android:textColor="@color/colorAccent"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Stories/Suggestions Horizontal RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_suggestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:clipToPadding="false"
                android:paddingStart="8dp"
                android:paddingEnd="14dp" />

            <!-- Feed Header Title -->
            <TextView
                android:id="@+id/tv_feed_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bảng tin âm nhạc"
                android:textColor="@color/colorTextPrimary"
                android:textStyle="bold"
                android:textSize="15sp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="4dp" />

            <!-- Thông báo số lượng kết quả tìm kiếm -->
            <TextView
                android:id="@+id/tv_search_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"
                android:text="Tìm thấy 2 bài viết &amp; ca khúc"
                android:textColor="@color/colorAccent"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Feed RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_feed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false" />

            <!-- Trạng thái cuối danh sách: đang tải thêm / đã hết / đang xem dữ liệu offline -->
            <TextView
                android:id="@+id/tv_feed_footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="10dp"
                android:paddingBottom="14dp"
                android:textColor="@color/colorTextSecondary"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Empty Search State khi không tìm thấy kết quả -->
            <LinearLayout
                android:id="@+id/layout_search_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="28dp"
                android:paddingBottom="40dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:backgroundTint="#F5F3FF"
                    android:layout_marginBottom="14dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_search"
                        android:layout_gravity="center"
                        app:tint="@color/colorAccent" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_search_empty_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Không tìm thấy kết quả phù hợp"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tv_search_empty_msg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Không có bài hát hay bài viết nào khớp với từ khóa.\nHãy thử tìm theo tên nghệ sĩ hoặc thể loại khác!"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginBottom="16dp" />

                <!-- Các chip gợi ý nhanh để người dùng bấm vào là tìm được ngay -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gợi ý từ khóa tìm kiếm nhanh:"
                    android:textColor="@color/colorInputHint"
                    android:textSize="11.5sp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/chip_suggest_sayhi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_unselected"
                        android:text="Say Hi"
                        android:textColor="@color/colorAccent"
                        android:textSize="12sp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/chip_suggest_vpop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_unselected"
                        android:text="V-Pop"
                        android:textColor="@color/colorAccent"
                        android:textSize="12sp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/chip_suggest_hieu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_unselected"
                        android:text="HIEUTHUHAI"
                        android:textColor="@color/colorAccent"
                        android:textSize="12sp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp" />
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_reset_search"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginTop="16dp"
                    android:text="Xem tất cả bài viết"
                    android:textColor="@color/colorAccent"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_tag_chip"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
