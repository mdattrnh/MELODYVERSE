<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_gradient"
    android:padding="14dp"
    android:layout_marginBottom="12dp"
    android:elevation="3dp">

    <!-- Top info row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tv_admin_post_author"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@minhthu"
            android:textColor="@color/colorAccent"
            android:textStyle="bold"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_admin_post_genre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="V-POP"
            android:textColor="@color/colorNeonPink"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:background="@drawable/bg_tag_chip"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
    </LinearLayout>

    <!-- Song title and artist -->
    <TextView
        android:id="@+id/tv_admin_post_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="50 Cuộc Gọi Nhỡ"
        android:textColor="@color/colorTextPrimary"
        android:textStyle="bold"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tv_admin_post_artist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tinh Hà Say Hi • Tập 8"
        android:textColor="@color/colorTextSecondary"
        android:textSize="12.5sp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="8dp" />

    <!-- Caption snippet -->
    <TextView
        android:id="@+id/tv_admin_post_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nội dung bài viết..."
        android:textColor="@color/colorTextMuted"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginBottom="10dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/colorSurfaceBorder"
        android:layout_marginBottom="10dp" />

    <!-- Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Stats -->
        <TextView
            android:id="@+id/tv_admin_post_stats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="512 lượt thích • 64 bình luận"
            android:textColor="@color/colorTextSecondary"
            android:textSize="11.5sp" />

        <!-- Play button -->
        <TextView
            android:id="@+id/btn_admin_play_post"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="Nghe thử"
            android:textColor="@color/colorNeonCyan"
            android:textStyle="bold"
            android:textSize="12sp"
            android:gravity="center"
            android:background="@drawable/bg_tag_chip"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginEnd="8dp" />

        <!-- Delete button -->
        <TextView
            android:id="@+id/btn_admin_delete_post"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="Xóa bài"
            android:textColor="@color/colorNeonPink"
            android:textStyle="bold"
            android:textSize="12sp"
            android:gravity="center"
            android:background="@drawable/bg_tag_chip"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />
    </LinearLayout>

</LinearLayout>
