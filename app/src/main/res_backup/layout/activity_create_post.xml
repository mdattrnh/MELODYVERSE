<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_screen_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tv_create_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tạo bài viết mới"
                android:textColor="@color/colorTextPrimary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Post Button with gradient -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_post"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="ĐĂNG BÀI"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="13sp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="@drawable/bg_gradient_button" />
        </LinearLayout>

        <!-- User Info Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_avatar_circle"
                android:src="@drawable/ic_person"
                android:padding="8dp"
                app:tint="@color/colorNeonCyan" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tv_author_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phạm Minh Thư"
                    android:textColor="@color/colorTextPrimary"
                    android:textStyle="bold"
                    android:textSize="15sp" />

                <!-- Interactive Privacy Badge Chip (Công khai / Riêng tư) -->
                <LinearLayout
                    android:id="@+id/btn_toggle_privacy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_tag_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="9dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:layout_marginTop="4dp">

                    <ImageView
                        android:id="@+id/iv_privacy_icon"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_public"
                        app:tint="@color/colorNeonCyan" />

                    <TextView
                        android:id="@+id/tv_privacy_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Công khai"
                        android:textColor="@color/colorNeonCyan"
                        android:textStyle="bold"
                        android:textSize="11.5sp"
                        android:layout_marginStart="4dp" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_arrow_drop_down"
                        app:tint="@color/colorTextSecondary"
                        android:layout_marginStart="2dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Caption Input Box -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nội dung bài viết"
            android:textColor="@color/colorTextSecondary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/et_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="3"
            android:maxLines="6"
            android:gravity="top|start"
            android:background="@drawable/bg_input_field"
            android:hint="Bạn đang nghĩ gì hoặc cảm nhận bài hát này ra sao?..."
            android:textColorHint="@color/colorInputHint"
            android:textColor="@color/colorTextPrimary"
            android:textSize="14sp"
            android:padding="16dp"
            android:layout_marginBottom="20dp" />

        <!-- Music Metadata Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_gradient"
            android:padding="18dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_music_note"
                    app:tint="@color/colorAccentGlow" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Đính kèm bài hát"
                    android:textColor="@color/colorTextPrimary"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:layout_marginStart="8dp" />

                <TextView
                    android:id="@+id/btn_fill_sample_song"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Điền mẫu"
                    android:textColor="@color/colorNeonCyan"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="?attr/selectableItemBackground"
                    android:padding="4dp" />
            </LinearLayout>

            <!-- Quick Select Trending Chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chip_sample_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cắt Đôi Nỗi Sầu"
                        android:textColor="@color/colorAccent"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_tag_chip"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/chip_sample_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bình Yên (Vũ.)"
                        android:textColor="@color/colorNeonPink"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_tag_chip"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/chip_sample_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đi Về Nhà (Đen Vâu)"
                        android:textColor="@color/colorNeonCyan"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_tag_chip"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Song Title Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tên bài hát *"
                android:textColor="@color/colorTextSecondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/et_song_title"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_field"
                android:hint="Ví dụ: Từng Quen, Cắt Đôi Nỗi Sầu..."
                android:textColorHint="@color/colorInputHint"
                android:textColor="@color/colorTextPrimary"
                android:textSize="14sp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:layout_marginBottom="12dp" />

            <!-- Artist Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ca sĩ / Nghệ sĩ *"
                android:textColor="@color/colorTextSecondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/et_artist_name"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_field"
                android:hint="Ví dụ: Wren Evans, HIEUTHUHAI..."
                android:textColorHint="@color/colorInputHint"
                android:textColor="@color/colorTextPrimary"
                android:textSize="14sp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:layout_marginBottom="12dp" />

            <!-- Genre Spinner (Bài 4 - Spinners & User Controls) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thể loại âm nhạc (Genre) *"
                android:textColor="@color/colorTextSecondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spinner_genre"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_field"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginBottom="12dp" />

            <!-- Music URL Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Link bài hát (Audius / MP3) *"
                android:textColor="@color/colorTextSecondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/et_music_url"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_field"
                android:hint="Dán link audius.co/... hoặc link .mp3"
                android:textColorHint="@color/colorInputHint"
                android:textColor="@color/colorTextPrimary"
                android:textSize="13sp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:layout_marginBottom="12dp" />

            <!-- Gọi Audius API tìm bài hát -->
            <TextView
                android:id="@+id/btn_search_audius"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="🔎  Tìm nhạc trên Audius"
                android:textColor="@color/colorNeonCyan"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_input_field"
                android:foreground="?attr/selectableItemBackground"
                android:layout_marginTop="-4dp"
                android:layout_marginBottom="12dp" />

            <!-- Hashtags Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hashtags"
                android:textColor="@color/colorTextSecondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/et_hashtags"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_field"
                android:hint="#NhacViet #Trending"
                android:textColorHint="@color/colorInputHint"
                android:textColor="@color/colorTextPrimary"
                android:textSize="14sp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
