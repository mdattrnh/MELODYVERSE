<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_gradient"
    android:padding="20dp">

    <!-- Top Handle Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="@drawable/bg_tag_chip"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp" />

    <!-- Header Title & Close -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CHIA SẺ GIAI ĐIỆU"
            android:textColor="@color/colorAccent"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:layout_centerVertical="true" />

        <ImageView
            android:id="@+id/btn_share_dialog_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:layout_alignParentEnd="true"
            app:tint="@color/colorTextSecondary" />
    </RelativeLayout>

    <!-- Track Preview Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_input_field"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:layout_marginBottom="18dp">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_record_vinyl_mini">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_music_note"
                android:layout_gravity="center"
                app:tint="@color/white" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/tv_share_song_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="50 Cuộc Gọi Nhỡ"
                android:textColor="@color/colorTextPrimary"
                android:textStyle="bold"
                android:textSize="14sp"
                android:singleLine="true" />

            <TextView
                android:id="@+id/tv_share_song_artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tinh Hà Say Hi • Tập 8"
                android:textColor="@color/colorTextSecondary"
                android:textSize="12sp"
                android:layout_marginTop="2dp"
                android:singleLine="true" />

            <TextView
                android:id="@+id/tv_share_song_url"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="https://melodyverse.vn/track/p1"
                android:textColor="@color/colorNeonCyan"
                android:textSize="11sp"
                android:layout_marginTop="2dp"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- Share Option 1: Copy Link -->
    <LinearLayout
        android:id="@+id/opt_share_copy_link"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_bookmark"
            android:background="@drawable/bg_avatar_circle"
            android:padding="9dp"
            app:tint="@color/colorNeonCyan"
            android:layout_marginEnd="14dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sao chép liên kết bài hát"
                android:textColor="@color/colorTextPrimary"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lưu link vào bộ nhớ tạm để dán vào tin nhắn"
                android:textColor="@color/colorTextSecondary"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/colorSurfaceBorder"
        android:layout_marginStart="58dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp" />

    <!-- Share Option 2: Share to MelodyVerse Feed -->
    <LinearLayout
        android:id="@+id/opt_share_feed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_add"
            android:background="@drawable/bg_avatar_circle"
            android:padding="9dp"
            app:tint="@color/colorNeonPink"
            android:layout_marginEnd="14dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chia sẻ lên bài đăng MelodyVerse"
                android:textColor="@color/colorTextPrimary"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tạo bài viết mới đính kèm bài hát này"
                android:textColor="@color/colorTextSecondary"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
