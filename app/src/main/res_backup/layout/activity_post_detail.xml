<?xml version="1.0" encoding="utf-8"?>
<!-- Vuốt xuống để tải lại bài viết + bình luận mới nhất từ Firebase -->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipe_refresh_detail"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<androidx.core.widget.NestedScrollView
    android:id="@+id/scroll_post_detail"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_screen_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <!-- Top Header Navigation Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageView
                android:id="@+id/iv_detail_back"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_arrow_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="7dp"
                app:tint="@color/colorTextPrimary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CHI TIẾT BÀI VIẾT"
                    android:textColor="@color/colorAccent"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:letterSpacing="0.06" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MelodyVerse Community"
                    android:textColor="@color/colorTextMuted"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Chỉ hiện với tác giả bài viết -->
            <ImageView
                android:id="@+id/iv_detail_edit_top"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_edit"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="7dp"
                android:contentDescription="Chỉnh sửa bài viết"
                android:visibility="gone"
                app:tint="@color/colorTextSecondary" />

            <ImageView
                android:id="@+id/iv_detail_delete_top"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_delete"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="7dp"
                android:contentDescription="Xóa bài viết"
                android:visibility="gone"
                app:tint="@color/colorNeonPink" />

            <ImageView
                android:id="@+id/iv_detail_share_top"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_share"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="7dp"
                app:tint="@color/colorTextSecondary" />
        </LinearLayout>

        <!-- Main Post Card -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_gradient"
            android:elevation="4dp"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <!-- Author Header -->
            <ImageView
                android:id="@+id/iv_detail_avatar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_avatar_circle"
                android:src="@drawable/ic_person"
                android:padding="9dp"
                app:tint="@color/colorPrimary"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                app:layout_constraintTop_toTopOf="@id/iv_detail_avatar"
                app:layout_constraintBottom_toBottomOf="@id/iv_detail_avatar"
                app:layout_constraintStart_toEndOf="@id/iv_detail_avatar"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_detail_author"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ngọc Thành"
                        android:textColor="@color/colorTextPrimary"
                        android:textStyle="bold"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tv_detail_username"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" • @ngocthanh"
                        android:textColor="@color/colorTextMuted"
                        android:textSize="12sp"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp">

                    <TextView
                        android:id="@+id/tv_detail_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2 giờ trước"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" • "
                        android:textColor="@color/colorTextMuted"
                        android:textSize="12sp" />

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_public"
                        app:tint="@color/colorTextMuted" />
                </LinearLayout>
            </LinearLayout>

            <!-- Post Caption -->
            <TextView
                android:id="@+id/tv_detail_caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Chill cùng Tinh Hà nào.\nBài này nghe là thấy cả vũ trụ luôn!"
                android:textColor="@color/colorTextPrimary"
                android:lineSpacingExtra="5dp"
                android:textSize="15sp"
                app:layout_constraintTop_toBottomOf="@id/iv_detail_avatar" />

            <!-- Music Card with Rotating Vinyl -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_detail_music_card"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_music_card"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                app:layout_constraintTop_toBottomOf="@id/tv_detail_caption">

                <!-- Vinyl Record Artwork -->
                <FrameLayout
                    android:id="@+id/frame_detail_music_art"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_record_vinyl"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_music_note"
                        android:layout_gravity="center"
                        app:tint="@color/white" />
                </FrameLayout>

                <!-- Track Details -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/frame_detail_music_art"
                    app:layout_constraintEnd_toStartOf="@id/layout_detail_eq_wave">

                    <TextView
                        android:id="@+id/tv_detail_song_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="50 Cuộc Gọi Nhỡ"
                        android:textColor="@color/colorTextPrimary"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tv_detail_song_artist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Tinh Hà Say Hi • Tập 8"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="12.5sp"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Lossless • 320kbps • Studio Quality"
                        android:textColor="@color/colorAccent"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Sound Wave Equalizer -->
                <LinearLayout
                    android:id="@+id/layout_detail_eq_wave"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:layout_marginEnd="10dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/iv_detail_music_play">

                    <View
                        android:id="@+id/detail_eq_bar_1"
                        android:layout_width="3.5dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_eq_bar"
                        android:layout_marginEnd="3dp" />

                    <View
                        android:id="@+id/detail_eq_bar_2"
                        android:layout_width="3.5dp"
                        android:layout_height="18dp"
                        android:background="@drawable/bg_eq_bar"
                        android:layout_marginEnd="3dp" />

                    <View
                        android:id="@+id/detail_eq_bar_3"
                        android:layout_width="3.5dp"
                        android:layout_height="12dp"
                        android:background="@drawable/bg_eq_bar"
                        android:layout_marginEnd="3dp" />

                    <View
                        android:id="@+id/detail_eq_bar_4"
                        android:layout_width="3.5dp"
                        android:layout_height="16dp"
                        android:background="@drawable/bg_eq_bar" />
                </LinearLayout>

                <!-- Play/Pause Button -->
                <ImageView
                    android:id="@+id/iv_detail_music_play"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@drawable/ic_play"
                    android:background="@drawable/bg_play_button"
                    android:padding="11dp"
                    app:tint="@color/white"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Genre & Hashtags row -->
            <LinearLayout
                android:id="@+id/layout_detail_tags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/layout_detail_music_card">

                <TextView
                    android:id="@+id/tv_detail_genre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tag_chip"
                    android:text="V-POP"
                    android:textColor="@color/colorNeonPink"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tv_detail_hashtags"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="#TinhHaSayHi #NhacViet #MelodyVerse"
                    android:textColor="@color/colorAccent"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:id="@+id/divider_detail"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/colorSurfaceBorder"
                android:layout_marginTop="14dp"
                app:layout_constraintTop_toBottomOf="@id/layout_detail_tags" />

            <!-- Interactive Action Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintTop_toBottomOf="@id/divider_detail">

                <!-- Like -->
                <LinearLayout
                    android:id="@+id/btn_detail_like"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?attr/selectableItemBackground"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:id="@+id/iv_detail_like"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_heart"
                        app:tint="@color/colorTextSecondary" />

                    <TextView
                        android:id="@+id/tv_detail_like_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="248"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginStart="6dp" />
                </LinearLayout>

                <!-- Comment -->
                <LinearLayout
                    android:id="@+id/btn_detail_comment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?attr/selectableItemBackground"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="14dp"
                    android:layout_marginStart="8dp">

                    <ImageView
                        android:id="@+id/iv_detail_comment"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_comment"
                        app:tint="@color/colorAccent" />

                    <TextView
                        android:id="@+id/tv_detail_comment_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="32"
                        android:textColor="@color/colorAccent"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginStart="6dp" />
                </LinearLayout>

                <!-- Share -->
                <LinearLayout
                    android:id="@+id/btn_detail_share"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?attr/selectableItemBackground"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="14dp"
                    android:layout_marginStart="8dp">

                    <ImageView
                        android:id="@+id/iv_detail_share"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_share"
                        app:tint="@color/colorTextSecondary" />

                    <TextView
                        android:id="@+id/tv_detail_share_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginStart="6dp" />
                </LinearLayout>

                <!-- Bookmark -->
                <ImageView
                    android:id="@+id/iv_detail_bookmark"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_bookmark"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="2dp"
                    app:tint="@color/colorTextSecondary" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Community Comments Section Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_gradient"
            android:elevation="3dp"
            android:padding="16dp">

            <!-- Section Title Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_comment"
                    app:tint="@color/colorAccent"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="BÌNH LUẬN"
                    android:textColor="@color/colorTextPrimary"
                    android:textStyle="bold"
                    android:textSize="13.5sp" />

                <!-- Nút thả xuống sắp xếp bình luận nhỏ gọn bo tròn đẹp mắt -->
                <LinearLayout
                    android:id="@+id/btn_comment_sort"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_tag_chip"
                    android:paddingStart="8dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:id="@+id/tv_comment_sort_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mới nhất"
                        android:textColor="@color/colorAccent"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="2dp"
                        android:src="@drawable/ic_arrow_drop_down"
                        app:tint="@color/colorAccent" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_detail_comments_header_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tag_chip"
                    android:text="2 bình luận"
                    android:textColor="@color/colorAccent"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp" />
            </LinearLayout>

            <!-- Comments List RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_detail_comments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_detail_comments_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chưa có bình luận nào. Hãy là người đầu tiên chia sẻ cảm nghĩ!"
                android:textColor="@color/colorTextMuted"
                android:textSize="13sp"
                android:gravity="center"
                android:padding="16dp"
                android:visibility="gone" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/colorSurfaceBorder"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="14dp" />

            <!-- Add Comment Input Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:src="@drawable/ic_person"
                    android:padding="7dp"
                    app:tint="@color/colorNeonPink"
                    android:layout_marginEnd="10dp" />

                <EditText
                    android:id="@+id/et_detail_comment_input"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_field"
                    android:hint="Viết cảm nghĩ của bạn..."
                    android:textColorHint="@color/colorInputHint"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="13sp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_detail_send_comment"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="Gửi"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:background="@drawable/bg_gradient_button"
                    android:layout_marginStart="8dp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Bài hát tương tự (cùng thể loại, lưu tối đa 5 bài để xem offline) -->
        <LinearLayout
            android:id="@+id/layout_detail_similar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card_gradient"
            android:elevation="3dp"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_music_note"
                    app:tint="@color/colorAccent"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BÀI HÁT TƯƠNG TỰ"
                    android:textColor="@color/colorTextPrimary"
                    android:textStyle="bold"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_detail_similar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
