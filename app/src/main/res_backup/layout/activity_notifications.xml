<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_screen_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="24dp">

        <!-- Top Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="THÔNG BÁO"
                android:textColor="@color/colorTextPrimary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/btn_mark_all_read"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đã đọc tất cả"
                android:textColor="@color/colorAccent"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:background="?attr/selectableItemBackground"
                android:padding="6dp" />
        </LinearLayout>

        <!-- Notification List Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_gradient"
            android:padding="8dp"
            android:elevation="3dp">

            <!-- Item 1: Like Notification -->
            <LinearLayout
                android:id="@+id/notif_item_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:background="?attr/selectableItemBackground">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:backgroundTint="#FDF2F8">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_heart"
                        android:layout_gravity="center"
                        app:tint="@color/colorNeonPink" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Quang Hùng vừa thích bài hát bạn chia sẻ: 'Không Thể Say'"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10 phút trước • Chạm để nghe bài hát"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="11.5sp"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

                <View
                    android:id="@+id/dot_unread_1"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:background="@drawable/bg_circle_placeholder"
                    android:backgroundTint="@color/colorNeonCyan"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/colorSurfaceBorder" />

            <!-- Item 2: New Track Notification -->
            <LinearLayout
                android:id="@+id/notif_item_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:background="?attr/selectableItemBackground">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_record_vinyl">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_music_note"
                        android:layout_gravity="center"
                        app:tint="@color/white" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HIEUTHUHAI vừa phát hành ca khúc mới: 'Trình'"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 giờ trước • Khám phá ngay trên BXH"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="11.5sp"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

                <View
                    android:id="@+id/dot_unread_2"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:background="@drawable/bg_circle_placeholder"
                    android:backgroundTint="@color/colorNeonCyan"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/colorSurfaceBorder" />

            <!-- Item 3: Milestone Notification -->
            <LinearLayout
                android:id="@+id/notif_item_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:background="?attr/selectableItemBackground">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:backgroundTint="#FEF3C7">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_trophy"
                        android:layout_gravity="center"
                        app:tint="@color/colorGold" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chúc mừng! Bài chia sẻ của bạn đạt 1,000 lượt nghe"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3 giờ trước • '50 Cuộc Gọi Nhỡ' đang rất hot"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="11.5sp"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

                <View
                    android:id="@+id/dot_unread_3"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:background="@drawable/bg_circle_placeholder"
                    android:backgroundTint="@color/colorNeonCyan"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/colorSurfaceBorder" />

            <!-- Item 4: Comment Notification -->
            <LinearLayout
                android:id="@+id/notif_item_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:background="?attr/selectableItemBackground">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:backgroundTint="#EFF6FF">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_comment"
                        android:layout_gravity="center"
                        app:tint="@color/colorAccent" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ngọc Thành đã bình luận: 'Bản phối này nghe dính thực sự!'"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5 giờ trước • Chạm để xem chi tiết"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="11.5sp"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

                <View
                    android:id="@+id/dot_unread_4"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:background="@drawable/bg_circle_placeholder"
                    android:backgroundTint="@color/colorNeonCyan"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
