<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_gradient"
    android:padding="20dp">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tv_dialog_song_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Bình luận bài viết"
            android:textColor="@color/colorTextPrimary"
            android:textStyle="bold"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/btn_close_comment"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_more"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            app:tint="@color/colorTextSecondary" />
    </LinearLayout>

    <!-- Dynamic Comments List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_dialog_comments"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tv_dialog_empty_comments"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chưa có bình luận nào. Hãy là người đầu tiên chia sẻ cảm nghĩ!"
        android:textColor="@color/colorTextMuted"
        android:textSize="13sp"
        android:gravity="center"
        android:padding="12dp"
        android:visibility="gone" />

    <!-- Comment input row with framed box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/et_comment_input"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_field"
            android:hint="Viết cảm nghĩ của bạn..."
            android:textColorHint="@color/colorInputHint"
            android:textColor="@color/colorTextPrimary"
            android:textSize="13sp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_send_comment"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Gửi"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="13sp"
            android:background="@drawable/bg_gradient_button"
            android:layout_marginStart="8dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp" />
    </LinearLayout>

</LinearLayout>
