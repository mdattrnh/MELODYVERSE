<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_music_card"
    android:padding="10dp"
    android:layout_marginBottom="8dp">

    <!-- Track Order Number -->
    <TextView
        android:id="@+id/tv_track_index"
        android:layout_width="28dp"
        android:layout_height="wrap_content"
        android:text="01"
        android:textColor="@color/colorTextMuted"
        android:textStyle="bold"
        android:textSize="13sp"
        android:gravity="center" />

    <!-- Vinyl Artwork -->
    <FrameLayout
        android:id="@+id/frame_track_vinyl"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_record_vinyl"
        android:layout_marginStart="6dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_music_note"
            android:layout_gravity="center"
            app:tint="@color/white" />
    </FrameLayout>

    <!-- Track Information -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/tv_track_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Không Thể Say"
            android:textColor="@color/colorTextPrimary"
            android:textStyle="bold"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_track_artist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HIEUTHUHAI"
            android:textColor="@color/colorTextSecondary"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lossless • 320kbps"
            android:textColor="@color/colorAccent"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Equalizer Playing Indicator -->
    <LinearLayout
        android:id="@+id/layout_track_eq"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:visibility="gone"
        android:layout_marginEnd="10dp">

        <View
            android:id="@+id/track_eq_1"
            android:layout_width="3dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_eq_bar"
            android:layout_marginEnd="2.5dp" />

        <View
            android:id="@+id/track_eq_2"
            android:layout_width="3dp"
            android:layout_height="15dp"
            android:background="@drawable/bg_eq_bar"
            android:layout_marginEnd="2.5dp" />

        <View
            android:id="@+id/track_eq_3"
            android:layout_width="3dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_eq_bar" />
    </LinearLayout>

    <!-- Play/Pause Button -->
    <ImageView
        android:id="@+id/iv_track_play"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_play"
        android:background="@drawable/bg_play_button"
        android:padding="9dp"
        app:tint="@color/white" />

</LinearLayout>
