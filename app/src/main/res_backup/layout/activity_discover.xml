<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_screen_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="24dp">

        <!-- Top Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="KHÁM PHÁ &amp; BXH"
                android:textColor="@color/colorTextPrimary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <ImageView
                android:id="@+id/iv_discover_search"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_search"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="6dp"
                app:tint="@color/colorTextPrimary" />
        </LinearLayout>

        <!-- In-Place Search Bar for Discover (Ẩn mặc định, nhấn kính lúp để mở) -->
        <LinearLayout
            android:id="@+id/layout_discover_search_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="14dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="44dp">

                <EditText
                    android:id="@+id/et_discover_search"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_login_input"
                    android:hint="Tìm ca khúc trên BXH hoặc Playlist..."
                    android:textColorHint="@color/colorInputHint"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="13.5sp"
                    android:paddingStart="16dp"
                    android:paddingEnd="40dp"
                    android:drawableStart="@drawable/ic_search"
                    android:drawablePadding="10dp"
                    android:drawableTint="@color/colorPrimary"
                    android:imeOptions="actionSearch"
                    android:singleLine="true" />

                <ImageView
                    android:id="@+id/iv_clear_discover_search"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/ic_close"
                    android:padding="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="@color/colorTextSecondary"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_discover_search_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/colorAccent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp"
                android:layout_marginStart="4dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Top #1 Trending Hero Banner -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/card_top1_banner"
            android:layout_width="match_parent"
            android:layout_height="145dp"
            android:background="@drawable/bg_chip_selected"
            android:elevation="6dp"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <!-- Trophy Badge -->
            <LinearLayout
                android:id="@+id/layout_badge_top1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_tag_chip"
                android:backgroundTint="#FFFFFF"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_trophy"
                    app:tint="@color/colorGold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" #1 BXH MELODYVERSE"
                    android:textColor="@color/colorGold"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_banner_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="50 Cuộc Gọi Nhỡ"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/layout_badge_top1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btn_banner_play" />

            <TextView
                android:id="@+id/tv_banner_artist"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Tinh Hà Say Hi • 24.5K lượt nghe"
                android:textColor="#F3E8FF"
                android:textSize="13sp"
                android:layout_marginTop="3dp"
                app:layout_constraintTop_toBottomOf="@id/tv_banner_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btn_banner_play" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ca khúc được cộng đồng yêu thích nhất tuần này"
                android:textColor="#E9D5FF"
                android:textSize="11.5sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Play Button -->
            <ImageView
                android:id="@+id/btn_banner_play"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_play"
                android:background="@drawable/bg_avatar_circle"
                android:backgroundTint="@color/white"
                android:padding="12dp"
                app:tint="@color/colorAccent"
                android:elevation="4dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Section: Top BXH MelodyVerse -->
        <!-- Section: Top Ca Khúc Thịnh Hành Header -->
        <LinearLayout
            android:id="@+id/layout_chart_section_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Top Ca Khúc Thịnh Hành"
                android:textColor="@color/colorTextPrimary"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tuần này"
                android:textColor="@color/colorAccent"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Chart Items Container -->
        <LinearLayout
            android:id="@+id/layout_chart_section_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_gradient"
            android:padding="12dp"
            android:elevation="3dp"
            android:layout_marginBottom="22dp">

            <!-- Item 1: 50 Cuộc Gọi Nhỡ -->
            <LinearLayout
                android:id="@+id/chart_item_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:text="01"
                    android:textColor="@color/colorGold"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:gravity="center" />

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_record_vinyl"
                    android:layout_marginStart="10dp">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_music_note"
                        android:layout_gravity="center"
                        app:tint="@color/white" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="50 Cuộc Gọi Nhỡ"
                        android:textColor="@color/colorTextPrimary"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tinh Hà Say Hi • V-Pop"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btn_play_chart_1"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_play"
                    android:background="@drawable/bg_play_button"
                    android:padding="9dp"
                    app:tint="@color/white" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/colorSurfaceBorder"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp" />

            <!-- Item 2: Không Thể Say -->
            <LinearLayout
                android:id="@+id/chart_item_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:text="02"
                    android:textColor="@color/colorSilver"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:gravity="center" />

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_record_vinyl"
                    android:layout_marginStart="10dp">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_music_note"
                        android:layout_gravity="center"
                        app:tint="@color/white" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Không Thể Say"
                        android:textColor="@color/colorTextPrimary"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HIEUTHUHAI • Rap / Hip-Hop"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btn_play_chart_2"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_play"
                    android:background="@drawable/bg_play_button"
                    android:padding="9dp"
                    app:tint="@color/white" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/colorSurfaceBorder"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp" />

            <!-- Item 3: Thủy Triều Remix -->
            <LinearLayout
                android:id="@+id/chart_item_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:text="03"
                    android:textColor="@color/colorBronze"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:gravity="center" />

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_record_vinyl"
                    android:layout_marginStart="10dp">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_music_note"
                        android:layout_gravity="center"
                        app:tint="@color/white" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thủy Triều (Remix)"
                        android:textColor="@color/colorTextPrimary"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Quang Hùng MasterD • V-Pop"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btn_play_chart_3"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_play"
                    android:background="@drawable/bg_play_button"
                    android:padding="9dp"
                    app:tint="@color/white" />
            </LinearLayout>
        </LinearLayout>

        <!-- Section: Tuyển Tập Playlist Chọn Lọc -->
        <TextView
            android:id="@+id/layout_playlist_section_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tuyển Tập Playlist Chọn Lọc"
            android:textColor="@color/colorTextPrimary"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <HorizontalScrollView
            android:id="@+id/layout_playlist_section_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Playlist Card 1 -->
                <LinearLayout
                    android:id="@+id/card_playlist_1"
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_gradient"
                    android:padding="12dp"
                    android:elevation="3dp"
                    android:layout_marginEnd="12dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:background="@drawable/bg_chip_selected">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LO-FI FOCUS"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:layout_gravity="center" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Giai Điệu Thư Giãn"
                        android:textColor="@color/colorTextPrimary"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2 ca khúc • Lo-fi thư thái"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <!-- Playlist Card 2 -->
                <LinearLayout
                    android:id="@+id/card_playlist_2"
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_gradient"
                    android:padding="12dp"
                    android:elevation="3dp"
                    android:layout_marginEnd="12dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:background="@drawable/bg_gradient_button">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CHILL ACOUSTIC"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:layout_gravity="center" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sài Gòn Chiều Mưa"
                        android:textColor="@color/colorTextPrimary"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2 ca khúc • Acoustic sâu lắng"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <!-- Playlist Card 3 -->
                <LinearLayout
                    android:id="@+id/card_playlist_3"
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_gradient"
                    android:padding="12dp"
                    android:elevation="3dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:background="@drawable/bg_record_vinyl">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SAY HI ENERGY"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:layout_gravity="center" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gen Z Energy"
                        android:textColor="@color/colorTextPrimary"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3 ca khúc • Say Hi bùng nổ"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="11.5sp" />
                </LinearLayout>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Empty State for Discover Search -->
        <LinearLayout
            android:id="@+id/layout_discover_search_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_card_gradient"
            android:padding="28dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="24dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_search"
                app:tint="@color/colorTextMuted"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tv_discover_search_empty_msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Không tìm thấy ca khúc hoặc playlist nào phù hợp."
                android:textColor="@color/colorTextPrimary"
                android:textStyle="bold"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hãy thử tìm theo tên bài hát (50 Cuộc Gọi Nhỡ, Thủy Triều...) hoặc thể loại / playlist (Lo-fi, Chill, Energy...)"
                android:textColor="@color/colorTextSecondary"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginBottom="14dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_reset_discover_search"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Xóa bộ lọc tìm kiếm"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="12sp"
                android:background="@drawable/bg_chip_selected"
                android:paddingStart="18dp"
                android:paddingEnd="18dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
