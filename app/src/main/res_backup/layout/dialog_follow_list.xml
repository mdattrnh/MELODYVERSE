<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_gradient"
    android:padding="18dp">

    <!-- Header Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="@drawable/bg_tag_chip"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp" />

    <!-- Title Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/btn_close_follow">

            <TextView
                android:id="@+id/tv_follow_dialog_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ĐANG THEO DÕI (3)"
                android:textColor="@color/colorAccent"
                android:textStyle="bold"
                android:textSize="15sp"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tv_follow_dialog_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Các nghệ sĩ &amp; bạn bè bạn đang theo dõi"
                android:textColor="@color/colorTextMuted"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_close_follow"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_more"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="5dp"
            app:tint="@color/colorTextSecondary" />
    </RelativeLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/colorSurfaceBorder"
        android:layout_marginBottom="12dp" />

    <!-- User List RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_follow_list"
        android:layout_width="match_parent"
        android:layout_height="340dp"
        android:scrollbars="vertical" />

</LinearLayout>
