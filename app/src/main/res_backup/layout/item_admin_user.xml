<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_gradient"
    android:padding="14dp"
    android:layout_marginBottom="12dp"
    android:elevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Avatar -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_story_ring">

            <ImageView
                android:id="@+id/iv_admin_user_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_avatar_circle"
                android:src="@drawable/ic_person"
                android:padding="10dp"
                app:tint="@color/colorPrimary" />
        </FrameLayout>

        <!-- User Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/tv_admin_user_fullname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phạm Minh Thư"
                android:textColor="@color/colorTextPrimary"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_admin_user_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@minhthu"
                android:textColor="@color/colorAccent"
                android:textSize="12sp"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <!-- Role & Status Badges -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/tv_admin_user_role"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quản trị viên"
                android:textColor="@color/colorNeonOrange"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_tag_chip"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp" />

            <TextView
                android:id="@+id/tv_admin_user_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hoạt động"
                android:textColor="@color/colorNeonCyan"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginTop="3dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bio -->
    <TextView
        android:id="@+id/tv_admin_user_bio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Đam mê âm nhạc và chia sẻ cảm xúc..."
        android:textColor="@color/colorTextSecondary"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="10dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/colorSurfaceBorder"
        android:layout_marginBottom="10dp" />

    <!-- Action row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_admin_user_stats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="1 bài chia sẻ • 3 theo dõi"
            android:textColor="@color/colorTextMuted"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/btn_admin_toggle_lock"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Khóa TK"
            android:textColor="@color/colorNeonPink"
            android:textStyle="bold"
            android:textSize="11.5sp"
            android:gravity="center"
            android:background="@drawable/bg_input_field"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/btn_admin_toggle_role"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Đổi quyền"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="11.5sp"
            android:gravity="center"
            android:background="@drawable/bg_gradient_button"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />
    </LinearLayout>

</LinearLayout>
