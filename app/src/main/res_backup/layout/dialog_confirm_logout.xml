<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/bg_dialog_logout"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="26dp"
    android:paddingBottom="24dp"
    android:elevation="12dp">

    <!-- Icon Logout trong vòng tròn Gradient hồng tím -->
    <FrameLayout
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_avatar_circle"
        android:backgroundTint="#FDF2F8"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_logout"
            android:layout_gravity="center"
            app:tint="@color/colorNeonPink" />
    </FrameLayout>

    <!-- Tiêu đề xác nhận -->
    <TextView
        android:id="@+id/tv_dialog_logout_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Đăng Xuất Tài Khoản"
        android:textColor="@color/colorTextPrimary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:letterSpacing="0.02"
        android:layout_marginBottom="8dp" />

    <!-- Lời nhắc chi tiết -->
    <TextView
        android:id="@+id/tv_dialog_logout_msg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bạn có chắc chắn muốn đăng xuất khỏi MelodyVerse? Trình phát nhạc sẽ tạm dừng và bạn sẽ quay về màn hình đăng nhập."
        android:textColor="@color/colorTextSecondary"
        android:textSize="13.5sp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:layout_marginBottom="22dp" />

    <!-- Nút hành động Hủy và Đăng xuất -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_dialog_logout_cancel"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Hủy"
            android:textColor="@color/colorTextSecondary"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:background="@drawable/bg_input_field"
            android:layout_marginEnd="10dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_dialog_logout_confirm"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Đăng xuất"
            android:textColor="@color/white"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:background="@drawable/bg_gradient_button"
            android:elevation="2dp" />
    </LinearLayout>
</LinearLayout>
