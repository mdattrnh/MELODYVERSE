<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_gradient"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <!-- Header Drag Handle & Title -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="@drawable/bg_tag_chip"
        android:layout_marginBottom="12dp" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="ĐANG PHÁT TỪ BẢNG TIN"
            android:textColor="@color/colorAccent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <ImageView
            android:id="@+id/btn_close_player"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:src="@drawable/ic_more"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            app:tint="@color/colorTextSecondary" />
    </RelativeLayout>

    <!-- Big Spinning Vinyl Record Artwork -->
    <FrameLayout
        android:id="@+id/frame_big_vinyl"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:background="@drawable/bg_record_vinyl"
        android:elevation="6dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp">

        <View
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_avatar_circle"
            android:backgroundTint="@color/colorAccent"
            android:layout_gravity="center" />

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_music_note"
            android:layout_gravity="center"
            app:tint="@color/white" />
    </FrameLayout>

    <!-- Track Details -->
    <TextView
        android:id="@+id/tv_dialog_song_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="50 Cuộc Gọi Nhỡ"
        android:textColor="@color/colorTextPrimary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="marquee"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tv_dialog_song_artist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tinh Hà Say Hi • Tập 8"
        android:textColor="@color/colorTextSecondary"
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <!-- Genre Badge Chip -->
    <TextView
        android:id="@+id/tv_dialog_genre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="V-POP TRENDING"
        android:textColor="@color/colorNeonPink"
        android:textSize="11sp"
        android:textStyle="bold"
        android:background="@drawable/bg_tag_chip"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:layout_marginBottom="16dp" />

    <!-- Seek Bar Timeline -->
    <SeekBar
        android:id="@+id/seekbar_dialog_timeline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:progress="35"
        android:progressTint="@color/colorAccent"
        android:thumbTint="@color/colorAccent"
        android:layout_marginBottom="4dp" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_marginBottom="20dp">

        <TextView
            android:id="@+id/tv_dialog_time_current"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:15"
            android:textColor="@color/colorTextMuted"
            android:textSize="12sp"
            android:layout_alignParentStart="true" />

        <TextView
            android:id="@+id/tv_dialog_time_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:30"
            android:textColor="@color/colorTextMuted"
            android:textSize="12sp"
            android:layout_alignParentEnd="true" />
    </RelativeLayout>

    <!-- Playback Controls Row (Shuffle, Prev, Play/Pause, Next, Repeat) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <!-- Shuffle button -->
        <ImageView
            android:id="@+id/btn_dialog_shuffle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_shuffle"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="9dp"
            app:tint="@color/colorTextSecondary"
            android:layout_marginEnd="14dp" />

        <!-- Prev button -->
        <ImageView
            android:id="@+id/btn_dialog_prev"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_skip_previous"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="10dp"
            app:tint="@color/colorTextPrimary"
            android:layout_marginEnd="16dp" />

        <!-- Big Play / Pause Gradient Button -->
        <ImageView
            android:id="@+id/btn_dialog_play"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_pause"
            android:background="@drawable/bg_gradient_button"
            android:padding="16dp"
            app:tint="@color/white"
            android:elevation="4dp" />

        <!-- Next button -->
        <ImageView
            android:id="@+id/btn_dialog_next"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_skip_next"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="10dp"
            app:tint="@color/colorTextPrimary"
            android:layout_marginStart="16dp" />

        <!-- Repeat button -->
        <ImageView
            android:id="@+id/btn_dialog_repeat"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_repeat"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="9dp"
            app:tint="@color/colorTextSecondary"
            android:layout_marginStart="14dp" />
    </LinearLayout>

</LinearLayout>
